# .clang-tidy — libstrand
#
# Static analysis configuration. See TECH_STACK.md §7.4.
# Run via: make lint
#
# Enabled check groups:
#   clang-diagnostic-*  — compiler warnings surfaced as tidy diagnostics
#   clang-analyzer-*    — Clang static analyser (null deref, memory, etc.)
#   bugprone-*          — common bug-prone patterns
#   cert-c-*            — CERT C coding standard subset
#   misc-*              — miscellaneous checks
#
# Disabled checks are called out individually with a reason.  The
# test-clock and scope-walk hook variables intentionally have external linkage
# so test objects can control them.

Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-optin.portability.UnixAPI,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-multi-level-implicit-pointer-conversion,
  cert-c-*,
  misc-*,
  -misc-unused-parameters,
  -misc-include-cleaner,
  -misc-static-assert,
  -misc-no-recursion,
  -misc-use-internal-linkage

# Treat every tidy warning as an error at quality gates.
WarningsAsErrors: '*'

# Only report findings in project headers, not system headers.
HeaderFilterRegex: '(include|src)/.*\.h$'

CheckOptions: []
